# Free key from https://fredaccount.stlouisfed.org/apikeys
# Streamlit Cloud can use .streamlit/secrets.toml instead (see secrets.example.toml).
# Docker, Railway, and Render can set these same names in the environment.
FRED_API_KEY=paste_your_key_here

# Stripe secret key. Use sk_test_... while trying a card, then sk_live_... to take real payments.
# Developers → API keys. Never commit the key.
STRIPE_SECRET_KEY=

# Optional. Public address of this app, with no trailing slash, if the browser address is not available.
# APP_BASE_URL=https://macropulse-warn.streamlit.app

# Resend sends the account note and the plan note. Verify a domain you control first.
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
# MAIL_FROM=MacroPulse <hello@yourdomain.com>
