# Free key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=paste_your_key_here

# Instagram Graph API (Phase C — optional; dry-run works without these)
# IG_PAGE_ACCESS_TOKEN=
# IG_USER_ID=

# Higgsfield video (locked stack — Seedance 2.5 primary)
# Official pair from https://docs.higgsfield.ai/docs/authentication
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
# Aliases (either pair works):
# HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_SECRET=
# Or combined: HIGGSFIELD_API_KEY=key_id:key_secret
# Optional after Soul ID / Kling Elements setup:
# HIGGSFIELD_SOUL_ID=
# HIGGSFIELD_KLING_ELEMENT_ID=
# VIDEO_PROVIDER=higgsfield
